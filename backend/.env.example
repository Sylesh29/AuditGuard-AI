# Optional. Without a key the pipeline runs fully; the report uses a template summary
# and the ranking gets no second-opinion review.
ANTHROPIC_API_KEY=

# AUDITGUARD_LLM_MODEL=claude-sonnet-4-6
# AUDITGUARD_LLM_TIMEOUT_S=60
# AUDITGUARD_LLM_MAX_RETRIES=2
# AUDITGUARD_MAX_UPLOAD_MB=20
# AUDITGUARD_MAX_ROWS=500000
# AUDITGUARD_MAX_STORED_RUNS=50
# Comma-separated origins, only needed if the frontend is served from a different origin.
# AUDITGUARD_ALLOWED_ORIGINS=http://localhost:5500
# Path to your process specification (see backend/config/spec_limits.json).
# AUDITGUARD_SPEC_FILE=/etc/auditguard/spec_limits.json
