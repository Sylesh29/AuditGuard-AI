# All settings are optional. Without an API key the full pipeline still runs; the report uses
# a template summary and the ranking gets no second-opinion review.
#
# Set ONE provider key. Never commit a real key: .env is git-ignored.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# AUDITGUARD_LLM_PROVIDER=auto           # auto (Anthropic if its key is set, else Groq), anthropic, groq
# AUDITGUARD_LLM_ENABLED=auto            # auto (on when the provider's key is set), true or false
# AUDITGUARD_LLM_MODEL=                  # default: claude-sonnet-4-6 (Anthropic), llama-3.3-70b-versatile (Groq)
# AUDITGUARD_LLM_TIMEOUT_S=60
# AUDITGUARD_LLM_MAX_RETRIES=2

# AUDITGUARD_MAX_UPLOAD_MB=50
# AUDITGUARD_MAX_ROWS=500000
# AUDITGUARD_MAX_CONCURRENT_RUNS=2       # further uploads queue
# AUDITGUARD_MAX_STORED_RUNS=20
# AUDITGUARD_RUN_TTL_MINUTES=120         # finished runs and their data are deleted after this

# Your process specification (see backend/config/spec_limits.json for the format).
# AUDITGUARD_SPEC_FILE=/etc/auditguard/spec_limits.json

# Only needed if the frontend is served from a different origin than the API.
# AUDITGUARD_ALLOWED_ORIGINS=https://audit.example.com
